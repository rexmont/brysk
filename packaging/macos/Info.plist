<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>rustyfiles</string>
    <key>CFBundleIdentifier</key>
    <string>com.rustyfiles.app</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>rustyfiles</string>
    <key>CFBundleDisplayName</key>
    <string>rustyfiles</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.8.8</string>
    <key>CFBundleVersion</key>
    <string>0.8.8</string>
    <key>LSMinimumSystemVersion</key>
    <string>13.0</string>
    <key>LSMultipleInstancesProhibited</key>
    <false/>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- The folders the file manager reads: macOS shows its own consent prompt the first
         time one of them is touched (TCC), naming the app with these texts. -->
    <key>NSDesktopFolderUsageDescription</key>
    <string>rustyfiles shows and manages the files on your Desktop.</string>
    <key>NSDocumentsFolderUsageDescription</key>
    <string>rustyfiles shows and manages the files in your Documents folder.</string>
    <key>NSDownloadsFolderUsageDescription</key>
    <string>rustyfiles shows and manages the files in your Downloads folder.</string>
    <key>NSRemovableVolumesUsageDescription</key>
    <string>rustyfiles browses and copies files on external disks.</string>
    <key>NSNetworkVolumesUsageDescription</key>
    <string>rustyfiles browses and copies files on network shares.</string>
    <!-- Not sandboxed: a file manager must reach every folder the user can. Developer ID +
         hardened runtime is the distribution route. -->
    <key>NSHumanReadableCopyright</key>
    <string>MIT. rustyfiles is by Özer Güzel; the macOS port keeps the same licence.</string>
</dict>
</plist>