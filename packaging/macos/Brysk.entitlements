<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Open With, Open Terminal and Set Desktop Picture drive Finder/Terminal/System Events
         through Apple Events (osascript). The user still gets the Automation consent prompt. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
